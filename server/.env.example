PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/care4pets
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Development uploads are saved locally by default to avoid Cloudinary timeouts.
# Set this to true when you want to test Cloudinary uploads locally.
USE_CLOUDINARY_UPLOADS=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional in development. If empty, OTP and reset emails are printed
# in the backend console. Required in production.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
